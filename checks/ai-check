#!/usr/bin/env ruby
# frozen_string_literal: true

# ai-check — runs an AI-judged check: gathers the Ruby files this
# branch touches, sends them to headless Claude Code (`claude -p`) with a
# rubric, and turns the model's JSON verdict into the same exit-code
# contract the deterministic checks use. The rubric lives in the repo and
# is versioned like any other rule — prompt drift IS rule drift, and it
# shows up in diffs.
#
# AI checks trade determinism for judgment, so they're built to fail
# quiet, not noisy: the rubric ends with "when uncertain, pass", the judge
# is a fresh process with no stake in the code (the coding agent can't
# sweet-talk its reviewer), and they run at turn end only — never on the
# per-edit fast path, where latency would be felt on every keystroke.
#
#   .highball/packs/rails/checks/ai-check \
#     .highball/packs/rails/rubrics/comment-quality.md

require "json"
require "open3"

rubric_path = ARGV.fetch(0) { abort "usage: ai-check <rubric-file>" }

# encoding: explicit UTF-8 on every File.read in this script — hook and CI
# shells often run without LANG set, which drops Ruby's default external
# encoding to US-ASCII and makes any em-dash in a comment a crash.
rubric = File.read(rubric_path, encoding: "UTF-8")

def ref_exists?(ref)
  system("git rev-parse -q --verify #{ref}", out: File::NULL, err: File::NULL)
end

# Same "what does this branch touch" definition as bin/check-comments:
# branch commits + staged + unstaged + untracked, degrading gracefully in
# a repo with no main or no commits at all.
parts = [ `git diff --name-only`, `git ls-files --others --exclude-standard` ]
if ref_exists?("HEAD")
  parts << `git diff --name-only --cached`
  base = %w[origin/main main].find { |ref| ref_exists?(ref) }
  parts << `git diff --name-only #{`git merge-base #{base} HEAD`.strip} HEAD` if base
end

EXCLUDED_PREFIXES = %w[db/ bin/ config/ node_modules/ vendor/].freeze

# Caps the evidence bundle so the judge stays fast and cheap. Anything
# dropped is reported, never silently skipped — a cap that lies reads as
# "covered everything" when it didn't.
MAX_BUNDLE_BYTES = 48_000

files = parts.flat_map(&:lines).map(&:strip).uniq
             .select { |path| path.end_with?(".rb") && File.exist?(path) }
             .reject { |path| EXCLUDED_PREFIXES.any? { |prefix| path.start_with?(prefix) } }

exit 0 if files.empty?

bundle = +""
included = []
files.each do |file|
  source = File.read(file, encoding: "UTF-8")
  break if bundle.bytesize + source.bytesize > MAX_BUNDLE_BYTES

  bundle << "\n===== #{file} =====\n#{source}"
  included << file
end

prompt = <<~PROMPT
  You are a code-review judge. Apply ONLY the rubric below to the files
  provided. Do not invent rules the rubric does not state. When uncertain,
  pass — report only clear violations.

  RUBRIC:
  #{rubric}

  Respond with ONLY a JSON object, no markdown fences, in this shape:
  {"status":"passed","offenses":[]}
  or
  {"status":"failed","offenses":[{"file":"path","line":1,"message":"..."}]}

  FILES:
  #{bundle}
PROMPT

# HIGHBALL_JUDGE guards recursion: the judge session inherits this repo's
# Claude Code hooks, whose bin/checks exits immediately when this variable
# is set — otherwise the judge's own Stop hook would spawn another judge,
# forever. Haiku because judging against a narrow rubric is exactly the
# fast-and-cheap tier's job; bump the model per-rubric if one ever needs
# deeper reasoning.
stdout, stderr, status = Open3.capture3(
  { "HIGHBALL_JUDGE" => "1" },
  "claude", "-p",
  "--model", "claude-haiku-4-5-20251001",
  "--output-format", "json",
  stdin_data: prompt
)
abort "AI judge failed to run: #{stderr}" unless status.success?

# Same LANG-less-shell trap as the File.read calls above, but on the
# subprocess side: capture3 tags output with the default external encoding,
# so the judge's UTF-8 (em-dashes in verdict prose) arrives mis-tagged as
# US-ASCII and JSON.parse crashes. Retag before parsing.
stdout = stdout.force_encoding("UTF-8").scrub

raw = JSON.parse(stdout).fetch("result").strip

# Models occasionally wrap the verdict in fences or append a prose recap
# despite the "ONLY a JSON object" instruction — extract the outermost
# object instead of trusting the envelope to be bare JSON.
json = raw[/\{.*\}/m]
abort "AI judge returned no JSON verdict:\n#{raw}" unless json

begin
  verdict = JSON.parse(json)
rescue JSON::ParserError
  abort "AI judge returned an unparseable verdict:\n#{raw}"
end

skipped = files.size - included.size
note = skipped.positive? ? " (#{skipped} file(s) skipped for size)" : ""
puts "AI-judged #{included.size} file(s)#{note} against #{rubric_path}"

offenses = verdict.fetch("offenses", [])
if verdict["status"] == "passed" || offenses.empty?
  puts "0 offense(s)"
  exit 0
end

offenses.each do |offense|
  puts "#{offense['file']}:#{offense['line']}: #{offense['message']}"
end
puts "#{offenses.size} offense(s)"
exit 1
